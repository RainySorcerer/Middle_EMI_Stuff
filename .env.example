# Where the SQLite database lives (defaults to ./data/paisapilot.db)
# On a host, point this at a persistent volume.
# DATABASE_PATH=/absolute/path/to/paisapilot.db

# Invite-only beta gate. Defaults to on; set to "false" only for local development.
# BETA_INVITE_ONLY=true

# Optional: AI narration and PDF statement import.
# Gemini is the only provider that can read PDFs. Without it, PDF uploads are
# rejected with a clear message and CSV import still works.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: narration-only providers (no PDF reading).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
